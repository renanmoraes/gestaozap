# ===== Database =====
DATABASE_URL=postgresql://wa_invites:wa_invites@localhost:5432/wa_invites

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379

# ===== Ports =====
PORT=3001
VITE_PORT=3002

# ===== Email (Resend) =====
RESEND_API_KEY=your-resend-api-key-here
RESEND_FROM=noreply@gestaozap.digital
APP_BASE_DOMAIN=gestaozap.digital

# ===== Admin seed (company_id=0) =====
# Email: admin@gestaozap.digital
# Senha: definida em backend/src/db/seeds/index.js (seed inicial)

# ===== Authentication =====
# false = dev sem token; true ou NODE_ENV=production = exige login
AUTH_REQUIRED=false

# ===== Environment =====
NODE_ENV=development
VITE_API_URL=http://localhost:3001
